# ============================================================
#  音格 · 后端环境变量示例
#  使用方法：复制本文件为 .env，再按实际环境填写。
#  .env 已被 .gitignore 排除，绝对不会提交到仓库。
# ============================================================

# ---- 服务 ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- 数据库（必填）----
# 本地：mongodb://127.0.0.1:27017/yinge
# 云端：MongoDB Atlas 提供的连接串（形如 mongodb+srv://...）
MONGODB_URI=mongodb://127.0.0.1:27017/yinge

# ---- 鉴权（必填，请替换为随机长字符串）----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---- 跨域允许的前端地址（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 通义千问（人格解读，选填；不填则自动降级为模板文案）----
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- iTunes 音乐数据源（免密钥）----
# 默认地区 hk，回退顺序 hk -> tw -> us -> cn
ITUNES_COUNTRY=hk
ITUNES_COUNTRY_FALLBACK=hk,tw,us,cn
ITUNES_TIMEOUT_MS=8000

# ---- 音乐数据缓存新鲜度（天）----
CACHE_FRESH_DAYS=30
CACHE_STALE_DAYS=25

# ---- 防刷票阈值（轻度限流）----
# 只拦"脚本式疯狂连点"，不拦正常手速：300ms ≈ 每秒 3 票上限。
VOTE_MIN_INTERVAL_MS=300
VOTE_PER_MINUTE_LIMIT=120
VOTE_PER_DAY_LIMIT=800

# ============================================================
#  线上部署（Render + MongoDB Atlas）—— 这些**只在云平台面板里设**，
#  不要写进本地 .env（两套环境混用容易把本地库连到线上去）。
#  完整步骤见 docs/部署执行手册.html
# ============================================================
# ① MONGODB_URI → 换成 Atlas 连接串。
#    形如：mongodb+srv://<用户>:<密码>@cluster0.xxxxx.mongodb.net/yinge?retryWrites=true&writesConcern=majority
#    ⚠️ 密码里若有 @ # / ? % 等字符，必须先做 URL 编码（@ → %40、# → %23、/ → %2F）。
#    ⚠️ Atlas 的 Network Access 要放行 0.0.0.0/0（Render 的出网 IP 不固定）。
#    数据搬迁：node scripts/migrate-to-atlas.mjs "<上面的连接串>" --apply
# ② JWT_SECRET → **必须换新的随机长字符串**，不要复用本地那个。
#    生成命令：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ③ CORS_ORIGINS → 填你的 Vercel 域名，例如 https://yinge.vercel.app
#    （本地那两条可以留着，不影响线上，只是方便以后本机调试）
# ④ DASHSCOPE_API_KEY → 填了才启用通义千问解读；不填会自动走模板降级，功能不报错。
# ⑤ NODE_ENV=production 与 PORT 都由 Render 自动注入，**不要在面板里手写 PORT**。
# ⑥ ITUNES_* / CACHE_* / VOTE_* / LOG_LEVEL 用默认值即可，不用改。
