# ============================================================
#  音格 · 后端环境变量示例
#  使用方法：复制本文件为 .env，再按实际环境填写。
#  .env 已被 .gitignore 排除，绝对不会提交到仓库。
# ============================================================

# ---- 服务 ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- 数据库（必填）----
# 本地：mongodb://127.0.0.1:27017/yinge
# 云端：MongoDB Atlas 提供的连接串（形如 mongodb+srv://...）
MONGODB_URI=mongodb://127.0.0.1:27017/yinge

# ---- 鉴权（必填，请替换为随机长字符串）----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---- 跨域允许的前端地址（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 通义千问（人格解读，选填；不填则自动降级为模板文案）----
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- iTunes 音乐数据源（免密钥）----
# 默认地区 hk，回退顺序 hk -> tw -> us -> cn
ITUNES_COUNTRY=hk
ITUNES_COUNTRY_FALLBACK=hk,tw,us,cn
ITUNES_TIMEOUT_MS=8000

# ---- 音乐数据缓存新鲜度（天）----
CACHE_FRESH_DAYS=30
CACHE_STALE_DAYS=25

# ---- 防刷票阈值（与需求文档 NFR-S5 对齐）----
VOTE_MIN_INTERVAL_MS=3000
VOTE_PER_MINUTE_LIMIT=20
VOTE_PER_DAY_LIMIT=300
