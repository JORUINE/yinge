# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
dist/
# dist-before/ = 「改前基线」产物：由 `git show HEAD:frontend/src/components/BracketTree.vue`
# 覆盖源码后重建出来的那一份，只用于「同输入 A/B」比对（见 tools/pw/probe-r38b-list.mjs）。
# ⚠️ 它是**临时基线**，每次做 A/B 前必须重新构建，否则会拿旧代码当"改前"（假对照）。
dist-before/
build/
out/
*.tsbuildinfo

# ---- 环境变量与密钥（务必不要提交）----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- 日志 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 编辑器与系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- 临时文件 ----
*.tmp
*.bak
~$*

# ---- 个人资料（不上传）----
docs/答辩手册.html
docs/内部*.html
docs/*-私密*
_私密资料-不上传/

# ---- 改动前安全备份（自动生成，不入库）----
_backup/

# ---- 内部工具链（不上传，属工作材料）----
tools/
docs/工具链说明.md
docs/工具链说明.html

# ---- 运行时 / 临时产物 ----
frontend/vite.config.js.timestamp-*
scripts/.mongod.pid
